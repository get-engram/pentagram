{
  "name": "pentagram-hosted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PENTAGRAM", "class_name": "PentagramTenant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PentagramTenant"] }],
  "ai": { "binding": "AI" },
  // Development only — in production: npx wrangler secret put API_KEYS
  "vars": { "API_KEYS": "dev-key:dev" }
}
