{
  "name": "pentagram-db",
  "version": "0.4.1",
  "description": "A homoiconic memory substrate: episodic log, associative recall, graph links, and procedural memory in one S-expression language.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pentagram": "dist/repl.js",
    "pentagram-mcp": "dist/mcp.js"
  },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run smoke && npm run build",
    "repl": "tsx src/repl.ts",
    "mcp": "tsx src/mcp.ts",
    "smoke": "tsx scripts/smoke.ts",
    "semantic-check": "tsx scripts/semantic-check.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "keywords": ["memory", "ai-memory", "lisp", "s-expressions", "homoiconic", "vector-search", "hnsw", "knowledge-graph", "event-sourcing", "mcp"],
  "repository": { "type": "git", "url": "git+https://github.com/get-engram/pentagram.git" },
  "files": ["dist", "src", "README.md", "LICENSE", "docs/paper.md"],
  "license": "MIT",
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
